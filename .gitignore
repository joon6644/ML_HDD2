# Git Ignore File for 26_2_COIN Project

# Virtual Environment
.venv/
venv/
ENV/
env/

# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/

# Large Datasets & Resampled Cache (Ignore heavy files but track directory via .gitkeep)
*.parquet
data/**/*.parquet
data/model=*/**/*.parquet
*.npz
data/resampled_cache/*
!data/resampled_cache/.gitkeep

# Temporary Safe-guard Excel Backups
results/backup_master_results.csv

# Local User Configurations / Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS temporary files
.DS_Store
Thumbs.db