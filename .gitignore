project_B/runs/

# MLflow 추적 저장소
project_B/mlruns/
project_B/mlartifacts/
project_B/mlflow.db

# DuckDB 임시 파일
*.db
*.db.wal
project_B/.tmp/

# 리포트 산출물
project_B/reports/
